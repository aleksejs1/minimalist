---
import { useTranslations } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div id="search-modal" class="search-modal" aria-hidden="true">
  <div class="search-backdrop" id="search-backdrop"></div>
  <div class="search-dialog" role="dialog" aria-modal="true" aria-label={t('nav.search')}>
    <div class="search-header">
      <span class="search-title">{t('nav.search')}</span>
      <button type="button" class="search-close-btn" id="search-close" aria-label={t('search.close')}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div id="pagefind-search-container" class="pagefind-container">
      <p class="search-hint text-muted">{t('search.placeholder')}</p>
    </div>
  </div>
</div>

<style>
  .search-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .search-modal.open {
    display: flex;
  }

  .search-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }

  .search-dialog {
    position: relative;
    width: 100%;
    max-width: 640px;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
  }

  .search-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--border-color);
  }

  .search-title {
    font-size: 0.875rem;
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .search-close-btn {
    color: var(--text-muted);
    padding: 4px;
    border-radius: 4px;
  }

  .search-close-btn:hover {
    color: var(--text-primary);
    background-color: var(--bg-secondary);
  }

  .pagefind-container {
    padding: 1.25rem;
    overflow-y: auto;
  }

  .search-hint {
    font-size: 0.9rem;
  }

  /* Pagefind override styles */
  :global(.pagefind-ui) {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text-primary);
    --pagefind-ui-background: var(--bg-primary);
    --pagefind-ui-border: var(--border-color);
    --pagefind-ui-tag: var(--bg-secondary);
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: var(--font-sans);
  }

  :global(.pagefind-ui__search-input) {
    background-color: var(--bg-secondary) !important;
    color: var(--text-primary) !important;
    border: 1px solid var(--border-color) !important;
  }

  :global(.pagefind-ui__search-input:focus) {
    border-color: var(--border-focus) !important;
    outline: none !important;
  }

  :global(.pagefind-ui__result-link) {
    color: var(--text-primary) !important;
    font-weight: 700;
    text-decoration: none !important;
  }

  :global(.pagefind-ui__result-link:hover) {
    text-decoration: underline !important;
  }

  :global(.pagefind-ui__result-excerpt) {
    color: var(--text-secondary) !important;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  :global(.pagefind-ui__result-excerpt mark) {
    background-color: var(--badge-rec-bg) !important;
    color: var(--badge-rec-text) !important;
    padding: 0.1em 0.25em;
    border-radius: 3px;
    font-weight: 700;
  }

  :global(.pagefind-ui__message) {
    color: var(--text-muted) !important;
    font-size: 0.875rem;
  }

  :global(.pagefind-ui__button) {
    background-color: var(--bg-secondary) !important;
    color: var(--text-primary) !important;
    border: 1px solid var(--border-color) !important;
    border-radius: 6px !important;
  }
</style>

<script is:inline>
  let pagefindLoaded = false;

  function initPagefind() {
    if (pagefindLoaded) return;
    try {
      const script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.onload = () => {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '/pagefind/pagefind-ui.css';
        document.head.appendChild(link);
        
        // @ts-ignore
        if (window.PagefindUI) {
          const container = document.getElementById('pagefind-search-container');
          if (container) {
            container.innerHTML = '';
            // @ts-ignore
            new window.PagefindUI({
              element: '#pagefind-search-container',
              bundlePath: '/pagefind/',
              baseUrl: '/',
              showSubResults: true,
              showImages: false,
              autofocus: true,
              resetStyles: false,
              translations: {
                placeholder: '{t("search.placeholder")}',
                zero_results: '{t("search.noResults")}',
              }
            });
            pagefindLoaded = true;
          }
        }
      };
      document.body.appendChild(script);
    } catch (e) {
      console.warn('Pagefind is available in production build mode.');
    }
  }

  function openSearchModal() {
    const modal = document.getElementById('search-modal');
    if (!modal) return;
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    initPagefind();
    setTimeout(() => {
      const input = document.querySelector('.pagefind-ui__search-input');
      if (input) input.focus();
    }, 100);
  }

  function closeSearchModal() {
    const modal = document.getElementById('search-modal');
    if (!modal) return;
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  window.openSearch = openSearchModal;
  window.closeSearch = closeSearchModal;

  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) {
      e.preventDefault();
      openSearchModal();
    }
    if (e.key === 'Escape') {
      closeSearchModal();
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target;
    if (target && target.id === 'search-backdrop') {
      closeSearchModal();
    }
    if (target && (target.id === 'search-close' || target.closest('#search-close'))) {
      closeSearchModal();
    }
  });
</script>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, getLocalizedPath } from '../../../i18n/utils';
import { languages, type SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);

const pageTitle = lang === 'ru'
  ? 'Интерактивные утилиты и сборки'
  : lang === 'lv'
  ? 'Interaktīvās lietotnes un komplekti'
  : 'Interactive Utilities & Bundles';

const pageDesc = lang === 'ru'
  ? 'Набор практических инструментов и шаблонов для взвешенных решений о покупках, расчета часов жизни и организации цифрового порядка.'
  : lang === 'lv'
  ? 'Praktisku rīku un veidņu kopa apzinātiem lēmumiem par pirkumiem, dzīves laika aprēķinam un kārtībai.'
  : 'Local-first decision calculators, plain-text starter templates, and curated workflow software bundles.';

const utilities = [
  {
    tag: 'DECISION FLOWCHART',
    title: t('decisionTree.title'),
    desc: t('decisionTree.subtitle'),
    url: getLocalizedPath('/tools/decision-tree/', lang),
    action: lang === 'ru' ? 'Пройти 5 шагов →' : lang === 'lv' ? 'Sākt 5 soļu testu →' : 'Start 5-Step Test →',
  },
  {
    tag: 'LOCAL CALCULATOR',
    title: t('lifeEnergy.title'),
    desc: t('lifeEnergy.subtitle'),
    url: getLocalizedPath('/tools/life-energy/', lang),
    action: lang === 'ru' ? 'Рассчитать часы жизни →' : lang === 'lv' ? 'Aprēķināt stundas →' : 'Calculate Hours →',
  },
  {
    tag: 'PLAIN-TEXT STARTERS',
    title: t('templates.title'),
    desc: t('templates.subtitle'),
    url: getLocalizedPath('/tools/templates/', lang),
    action: lang === 'ru' ? 'Смотреть шаблоны →' : lang === 'lv' ? 'Skatīt veidnes →' : 'View Templates →',
  },
  {
    tag: 'CURATED BUNDLES',
    title: t('section.packs.title'),
    desc: t('section.packs.subtitle'),
    url: getLocalizedPath('/tools/packs/', lang),
    action: lang === 'ru' ? 'Смотреть сборки софта →' : lang === 'lv' ? 'Skatīt komplektus →' : 'Explore Packs →',
  },
];
---

<BaseLayout
  title={`${pageTitle} — minimalist.lv`}
  description={pageDesc}
  lang={lang}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`/${lang}/`}>{t('nav.home')}</a>
      <span class="sep">/</span>
      <a href={getLocalizedPath('/tools/', lang)}>{t('nav.tools')}</a>
      <span class="sep">/</span>
      <span class="current">{t('nav.utilities')}</span>
    </nav>

    <header class="page-header">
      <div class="category-badge mono">100% LOCAL-FIRST TOOLS</div>
      <h1 class="page-title">{pageTitle}</h1>
      <p class="page-subtitle text-secondary">{pageDesc}</p>
    </header>

    <div class="utilities-nav-bar">
      <a href={getLocalizedPath('/tools/', lang)} class="nav-tab mono">
        ← {lang === 'ru' ? 'Каталог программ' : lang === 'lv' ? 'Programmu katalogs' : 'Software Directory'}
      </a>
      <span class="nav-tab mono active">
        {t('nav.utilities')} (4)
      </span>
    </div>

    <div class="utilities-grid">
      {
        utilities.map((item) => (
          <a href={item.url} class="utility-card card">
            <span class="utility-tag mono text-muted">{item.tag}</span>
            <h2 class="utility-title">{item.title}</h2>
            <p class="utility-desc text-secondary">{item.desc}</p>
            <span class="utility-link mono">{item.action}</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-bottom: 2rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .breadcrumb a:hover {
    color: var(--text-primary);
  }

  .page-header {
    margin-bottom: 2rem;
    max-width: 760px;
  }

  .category-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .page-subtitle {
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .utilities-nav-bar {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .nav-tab {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    color: var(--text-secondary);
    transition: all 0.15s ease;
  }

  .nav-tab:hover {
    color: var(--text-primary);
    border-color: var(--border-focus);
  }

  .nav-tab.active {
    background-color: var(--accent);
    color: var(--accent-contrast);
    border-color: var(--accent);
  }

  .utilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .utility-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
  }

  .utility-tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .utility-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .utility-desc {
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .utility-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .utility-card:hover .utility-link {
    color: var(--accent);
  }
</style>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCard from '../../../components/ToolCard.astro';
import { useTranslations, getLocalizedPath } from '../../../i18n/utils';
import { languages, type SupportedLanguage } from '../../../i18n/ui';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);

const allTools = await getCollection('tools', ({ id }) => id.startsWith(`${lang}/`));

const categorySlugs = [
  'text-and-writing',
  'note-taking',
  'web-browsing',
  'communication',
  'task-management',
  'system-utilities',
  'media-and-readers',
  'hardware-and-edc',
] as const;

const categories = categorySlugs.map((slug) => ({
  slug,
  name: t(`category.${slug}` as any),
  desc: t(`category.${slug}.desc` as any),
  tools: allTools.filter((tool) => tool.data.category === slug),
}));
---

<BaseLayout
  title={`${t('section.tools.title')} — minimalist.lv`}
  description={t('section.tools.subtitle')}
  lang={lang}
>
  <div class="container">
    <header class="page-header">
      <div class="category-badge mono">{t('nav.tools')}</div>
      <h1 class="page-title">{t('section.tools.title')}</h1>
      <p class="page-subtitle text-secondary">{t('section.tools.subtitle')}</p>
    </header>

    <div class="view-switch-tabs">
      <span class="switch-tab active mono">
        {lang === 'ru' ? 'Каталог софта (8 категорий)' : lang === 'lv' ? 'Programmu katalogs' : 'Software Catalog'}
      </span>
      <a href={getLocalizedPath('/tools/utilities/', lang)} class="switch-tab mono">
        {t('nav.utilities')} (4) →
      </a>
    </div>

    <div class="category-nav-bar">
      <span class="filter-label mono">{t('tools.filter.all')}:</span>
      {
        categories.map((cat) => (
          <a href={`#${cat.slug}`} class="cat-pill mono">
            {cat.name} ({cat.tools.length})
          </a>
        ))
      }
    </div>

    <div class="tools-sections">
      {
        categories.map((cat) => (
          <section class="cat-section" id={cat.slug}>
            <div class="cat-header">
              <div>
                <h2 class="cat-title">{cat.name}</h2>
                <p class="cat-desc text-secondary">{cat.desc}</p>
              </div>
              <a href={getLocalizedPath(`/tools/${cat.slug}/`, lang)} class="cat-view-all mono">
                {cat.name} →
              </a>
            </div>

            <div class="tools-list">
              {cat.tools.map((tool) => (
                <ToolCard tool={tool.data} lang={lang} />
              ))}
              {cat.tools.length === 0 && (
                <p class="text-muted">Tools for this category will be listed shortly.</p>
              )}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    max-width: 700px;
  }

  .category-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .page-subtitle {
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .view-switch-tabs {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .switch-tab {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    color: var(--text-secondary);
    transition: all 0.15s ease;
    text-decoration: none;
  }

  .switch-tab:hover {
    color: var(--text-primary);
    border-color: var(--border-focus);
  }

  .switch-tab.active {
    background-color: var(--accent);
    color: var(--accent-contrast);
    border-color: var(--accent);
  }

  .category-nav-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 0;
    margin-bottom: 3rem;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .cat-pill {
    font-size: 0.8rem;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    transition: all 0.15s ease;
  }

  .cat-pill:hover {
    border-color: var(--border-focus);
    background-color: var(--bg-card-hover);
  }

  .cat-section {
    margin-bottom: 4rem;
  }

  .cat-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--border-color);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cat-title {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .cat-desc {
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }

  .cat-view-all {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .cat-view-all:hover {
    opacity: 0.75;
  }
</style>

---
import GuideLayout from '../../../layouts/GuideLayout.astro';
import { getCollection } from 'astro:content';
import { languages, type SupportedLanguage } from '../../../i18n/ui';

export async function getStaticPaths() {
  const allGuides = await getCollection('guides');

  return Object.keys(languages).flatMap((lang) => {
    const langGuides = allGuides
      .filter((g) => g.slug.startsWith(`${lang}/`))
      .sort((a, b) => a.data.order - b.data.order);

    return langGuides.map((guide, index) => {
      const cleanSlug = guide.slug.replace(`${lang}/`, '');
      const prevGuide = index > 0 ? {
        title: langGuides[index - 1].data.title,
        order: langGuides[index - 1].data.order,
        slug: langGuides[index - 1].slug.replace(`${lang}/`, ''),
      } : null;

      const nextGuide = index < langGuides.length - 1 ? {
        title: langGuides[index + 1].data.title,
        order: langGuides[index + 1].data.order,
        slug: langGuides[index + 1].slug.replace(`${lang}/`, ''),
      } : null;

      return {
        params: { lang, slug: cleanSlug },
        props: { guide, prevGuide, nextGuide },
      };
    });
  });
}

const { guide, prevGuide, nextGuide } = Astro.props;
const { lang } = Astro.params as { lang: SupportedLanguage };
const { Content, headings } = await guide.render();
---

<GuideLayout
  title={guide.data.title}
  description={guide.data.description}
  order={guide.data.order}
  category={guide.data.category}
  publishedDate={guide.data.publishedDate}
  readingTime={guide.data.readingTime}
  lang={lang}
  headings={headings}
  prevGuide={prevGuide}
  nextGuide={nextGuide}
>
  <Content />
</GuideLayout>

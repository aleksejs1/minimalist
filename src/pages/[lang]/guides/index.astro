---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, getLocalizedPath } from '../../../i18n/utils';
import { languages, type SupportedLanguage } from '../../../i18n/ui';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);

const allGuides = await getCollection('guides', ({ id }) => id.startsWith(`${lang}/`));
const sortedGuides = allGuides.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`${t('section.guides.title')} — minimalist.lv`}
  description={t('section.guides.subtitle')}
  lang={lang}
>
  <div class="container">
    <header class="page-header">
      <div class="category-badge mono">{t('nav.guides')}</div>
      <h1 class="page-title">{t('section.guides.title')}</h1>
      <p class="page-subtitle text-secondary">{t('section.guides.subtitle')}</p>
    </header>

    <div class="guides-list">
      {
        sortedGuides.map((guide) => {
          const cleanSlug = guide.slug.replace(`${lang}/`, '');
          return (
            <a href={getLocalizedPath(`/guides/${cleanSlug}/`, lang)} class="guide-list-item card">
              <div class="guide-item-meta">
                <span class="guide-number mono">#{String(guide.data.order).padStart(2, '0')}</span>
                <span class="guide-time text-muted mono">
                  {guide.data.readingTime} {t('meta.readingTime')}
                </span>
              </div>
              <div class="guide-item-content">
                <h2 class="guide-item-title">{guide.data.title}</h2>
                <p class="guide-item-desc text-secondary">{guide.data.description}</p>
              </div>
              <div class="guide-item-arrow">→</div>
            </a>
          );
        })
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 3rem;
    max-width: 700px;
  }

  .category-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .page-subtitle {
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .guides-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .guide-list-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    transition: all 0.15s ease;
  }

  .guide-item-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 60px;
  }

  .guide-number {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .guide-time {
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .guide-item-content {
    flex: 1;
  }

  .guide-item-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }

  .guide-item-desc {
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .guide-item-arrow {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .guide-list-item:hover .guide-item-arrow {
    color: var(--text-primary);
    transform: translateX(4px);
    transition: transform 0.15s ease;
  }

  @media (max-width: 640px) {
    .guide-list-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .guide-item-arrow {
      display: none;
    }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import { languages, type SupportedLanguage } from '../../i18n/ui';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);

const allGuides = await getCollection('guides', ({ id }) => id.startsWith(`${lang}/`));
const sortedGuides = allGuides.sort((a, b) => a.data.order - b.data.order);

const allBlogPosts = await getCollection('blog', ({ id }) => id.startsWith(`${lang}/`));
const recentBlogPosts = allBlogPosts.sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()).slice(0, 3);

const allTools = await getCollection('tools', ({ id }) => id.startsWith(`${lang}/`));

const categorySlugs = [
  'text-and-writing',
  'note-taking',
  'web-browsing',
  'communication',
  'task-management',
  'system-utilities',
  'media-and-readers',
  'hardware-and-edc',
] as const;

const categories = categorySlugs.map((slug) => ({
  slug,
  name: t(`category.${slug}` as any),
  desc: t(`category.${slug}.desc` as any),
  count: allTools.filter((t) => t.data.category === slug).length,
}));
---

<BaseLayout
  title={`${t('site.title')} — ${t('site.tagline')}`}
  description={t('site.description')}
  lang={lang}
>
  <div class="container">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-badge mono">{t('hero.badge')}</div>
      <h1 class="hero-title">{t('hero.title')}</h1>
      <p class="hero-subtitle text-secondary">{t('hero.subtitle')}</p>
      
      <div class="hero-actions">
        <a href={getLocalizedPath('/guides/', lang)} class="btn btn-hero-primary">
          {t('hero.cta.guides')} →
        </a>
        <a href={getLocalizedPath('/tools/', lang)} class="btn btn-hero-secondary">
          {t('hero.cta.tools')}
        </a>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- 1. Knowledge Base Section -->
    <section class="home-section">
      <div class="section-header">
        <div>
          <h2 class="section-title">{t('section.guides.title')}</h2>
          <p class="section-subtitle text-secondary">{t('section.guides.subtitle')}</p>
        </div>
        <a href={getLocalizedPath('/guides/', lang)} class="section-link mono">
          {t('section.guides.all')} →
        </a>
      </div>

      <div class="guides-grid">
        {
          sortedGuides.map((guide) => {
            const cleanSlug = guide.slug.replace(`${lang}/`, '');
            return (
              <a href={getLocalizedPath(`/guides/${cleanSlug}/`, lang)} class="guide-card card">
                <div class="guide-card-header">
                  <span class="guide-order mono">#{String(guide.data.order).padStart(2, '0')}</span>
                  <span class="guide-reading-time text-muted mono">
                    {guide.data.readingTime} {t('meta.readingTime')}
                  </span>
                </div>
                <h3 class="guide-card-title">{guide.data.title}</h3>
                <p class="guide-card-desc text-secondary">{guide.data.description}</p>
              </a>
            );
          })
        }
      </div>
    </section>

    <!-- 2. Software Catalog Section -->
    <section class="home-section">
      <div class="section-header">
        <div>
          <h2 class="section-title">{t('section.tools.title')}</h2>
          <p class="section-subtitle text-secondary">{t('section.tools.subtitle')}</p>
        </div>
        <a href={getLocalizedPath('/tools/', lang)} class="section-link mono">
          {t('section.tools.all')} →
        </a>
      </div>

      <div class="categories-grid">
        {
          categories.map((cat) => (
            <a href={getLocalizedPath(`/tools/${cat.slug}/`, lang)} class="category-card card">
              <div class="cat-card-top">
                <h3 class="cat-title">{cat.name}</h3>
                <span class="cat-count mono badge badge-recommended">{cat.count} apps</span>
              </div>
              <p class="cat-desc text-secondary">{cat.desc}</p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- 3. Setup Packs & Interactive Flowchart Highlight -->
    <section class="home-section">
      <div class="utils-banner-grid">
        <a href={getLocalizedPath('/tools/packs/', lang)} class="banner-card card">
          <span class="mono banner-tag">CURATED BUNDLES</span>
          <h3 class="banner-title">{t('section.packs.title')}</h3>
          <p class="banner-desc text-secondary">{t('section.packs.subtitle')}</p>
          <span class="banner-link mono">Explore Packs →</span>
        </a>

        <a href={getLocalizedPath('/tools/decision-tree/', lang)} class="banner-card card">
          <span class="mono banner-tag">INTERACTIVE FLOWCHART</span>
          <h3 class="banner-title">{t('decisionTree.title')}</h3>
          <p class="banner-desc text-secondary">{t('decisionTree.subtitle')}</p>
          <span class="banner-link mono">Start 5-Step Test →</span>
        </a>
      </div>
    </section>

    <!-- 4. Blog Highlight Section -->
    {
      recentBlogPosts.length > 0 && (
        <section class="home-section">
          <div class="section-header">
            <div>
              <h2 class="section-title">{t('section.blog.title')}</h2>
              <p class="section-subtitle text-secondary">{t('section.blog.subtitle')}</p>
            </div>
            <a href={getLocalizedPath('/blog/', lang)} class="section-link mono">
              {t('section.blog.all')} →
            </a>
          </div>

          <div class="blog-grid">
            {
              recentBlogPosts.map((post) => {
                const cleanSlug = post.slug.replace(`${lang}/`, '');
                const formattedDate = new Intl.DateTimeFormat(lang === 'lv' ? 'lv-LV' : lang === 'ru' ? 'ru-RU' : 'en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                }).format(post.data.publishedDate);

                return (
                  <a
                    href={getLocalizedPath(`/blog/${cleanSlug}/`, lang)}
                    class="blog-card card"
                  >
                    <div class="blog-card-meta mono">
                      <span class="blog-week-tag">
                        {post.data.weekNumber === 0 ? 'MANIFESTO' : `WEEK #${String(post.data.weekNumber).padStart(2, '0')}`}
                      </span>
                      <span class="text-muted">• {formattedDate}</span>
                      <span class="text-muted">• {post.data.readingTimeMinutes} {t('meta.readingTime')}</span>
                    </div>
                    <h3 class="blog-card-title">{post.data.title}</h3>
                    <p class="blog-card-desc text-secondary">{post.data.description}</p>
                    <div class="blog-card-footer mono">
                      <span>{lang === 'ru' ? 'Читать эссе →' : lang === 'lv' ? 'Lasīt eseju →' : 'Read essay →'}</span>
                    </div>
                  </a>
                );
              })
            }
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .hero-section {
    padding: 3.5rem 0 2.5rem;
    max-width: 820px;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.04em;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }

  .hero-subtitle {
    font-size: 1.2rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 680px;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-hero-primary {
    background-color: var(--accent);
    color: var(--accent-contrast);
    font-weight: 600;
    padding: 0.75rem 1.5rem;
  }

  .btn-hero-primary:hover {
    opacity: 0.85;
  }

  .btn-hero-secondary {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 0.75rem 1.5rem;
  }

  .btn-hero-secondary:hover {
    border-color: var(--border-focus);
    background-color: var(--bg-card-hover);
  }

  .section-divider {
    border: 0;
    height: 1px;
    background-color: var(--border-color);
    margin: 2rem 0;
  }

  .home-section {
    margin-bottom: 4.5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .section-subtitle {
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }

  .section-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .section-link:hover {
    opacity: 0.75;
  }

  .guides-grid, .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .guide-card, .category-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
  }

  .guide-card-header, .cat-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .guide-order {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .guide-reading-time {
    font-size: 0.75rem;
  }

  .guide-card-title, .cat-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .guide-card-desc, .cat-desc {
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.75rem;
    gap: 0.6rem;
  }

  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
  }

  .blog-week-tag {
    font-weight: 700;
    color: var(--text-primary);
  }

  .blog-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .blog-card-desc {
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }

  .blog-card-footer {
    margin-top: auto;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    padding-top: 0.5rem;
  }

  .utils-banner-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .banner-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .banner-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .banner-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .banner-desc {
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .banner-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: auto;
    padding-top: 0.5rem;
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2.25rem;
    }
    .utils-banner-grid {
      grid-template-columns: 1fr;
    }
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

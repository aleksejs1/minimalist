---
import BaseLayout from './BaseLayout.astro';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  weekNumber: number;
  publishedDate: Date;
  readingTimeMinutes: number;
  tags: string[];
  lang: SupportedLanguage;
}

const { title, description, weekNumber, publishedDate, readingTimeMinutes, tags, lang } = Astro.props;
const t = useTranslations(lang);

const formattedDate = new Intl.DateTimeFormat(lang === 'lv' ? 'lv-LV' : lang === 'ru' ? 'ru-RU' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishedDate);
---

<BaseLayout title={title} description={description} lang={lang} type="article">
  <div class="container-narrow">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`/${lang}/`}>{t('nav.home')}</a>
      <span class="sep">/</span>
      <a href={getLocalizedPath('/blog/', lang)}>{t('nav.blog')}</a>
      <span class="sep">/</span>
      <span class="current">{weekNumber === 0 ? 'Welcome' : `${t('meta.week')} ${weekNumber}`}</span>
    </nav>

    <article class="blog-article">
      <header class="blog-header">
        <div class="blog-meta-top">
          <span class="week-badge mono">
            {weekNumber === 0 ? 'MANIFESTO / WELCOME' : `${t('meta.week').toUpperCase()} #${String(weekNumber).padStart(2, '0')}`}
          </span>
        </div>
        <h1 class="blog-title">{title}</h1>
        <p class="blog-desc text-secondary">{description}</p>
        <div class="blog-meta text-muted">
          <span>{t('meta.publishedOn')} {formattedDate}</span>
          <span class="dot">•</span>
          <span>{readingTimeMinutes} {t('meta.readingTime')}</span>
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="blog-footer">
        {
          tags.length > 0 && (
            <div class="tags-list">
              {tags.map((tag) => (
                <span class="tag-badge mono">#{tag}</span>
              ))}
            </div>
          )
        }
        <hr />
        <a href={getLocalizedPath('/blog/', lang)} class="back-link">
          ← {t('section.blog.all')}
        </a>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-bottom: 2rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .breadcrumb a:hover {
    color: var(--text-primary);
  }

  .blog-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .week-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.75rem;
  }

  .blog-title {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.25;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .blog-desc {
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }

  .blog-footer {
    margin-top: 3.5rem;
  }

  .tags-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .tag-badge {
    font-size: 0.8rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background-color: var(--bg-secondary);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .back-link:hover {
    opacity: 0.75;
  }
</style>

---
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  order: number;
  category: string;
  publishedDate: Date;
  readingTime: number;
  lang: SupportedLanguage;
  headings: { depth: number; slug: string; text: string }[];
}

const { title, description, order, publishedDate, readingTime, lang, headings } = Astro.props;
const t = useTranslations(lang);

const formattedDate = new Intl.DateTimeFormat(lang === 'lv' ? 'lv-LV' : lang === 'ru' ? 'ru-RU' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishedDate);
---

<BaseLayout title={title} description={description} lang={lang} type="article">
  <!-- Reading Progress Bar -->
  <div class="reading-progress-bar" id="reading-progress"></div>

  <div class="container guide-layout-container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`/${lang}/`}>{t('nav.home')}</a>
      <span class="sep">/</span>
      <a href={getLocalizedPath('/guides/', lang)}>{t('nav.guides')}</a>
      <span class="sep">/</span>
      <span class="current">#{String(order).padStart(2, '0')}</span>
    </nav>

    <div class="guide-grid">
      <article class="guide-article">
        <header class="article-header">
          <div class="header-top-row">
            <div class="order-tag mono">GUIDE #{String(order).padStart(2, '0')}</div>
            <button
              type="button"
              class="zen-toggle-btn mono"
              id="zen-mode-toggle"
              title="Toggle Zen / Focus Mode (Z)"
            >
              ☯ Zen Mode
            </button>
          </div>
          <h1 class="article-title">{title}</h1>
          <p class="article-desc text-secondary">{description}</p>
          <div class="article-meta text-muted">
            <span>{t('meta.publishedOn')} {formattedDate}</span>
            <span class="dot">•</span>
            <span>{readingTime} {t('meta.readingTime')}</span>
          </div>
        </header>

        <div class="prose">
          <slot />
        </div>

        <footer class="article-footer">
          <hr />
          <div class="footer-cta">
            <a href={getLocalizedPath('/guides/', lang)} class="back-link">
              ← {t('section.guides.all')}
            </a>
          </div>
        </footer>
      </article>

      <div class="guide-sidebar">
        <TOC headings={headings} lang={lang} />
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // Reading Progress Bar
  window.addEventListener('scroll', () => {
    const bar = document.getElementById('reading-progress');
    if (!bar) return;
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = totalHeight > 0 ? (window.scrollY / totalHeight) * 100 : 0;
    bar.style.width = progress + '%';
  });

  // Zen Mode Toggle
  const zenBtn = document.getElementById('zen-mode-toggle');
  if (zenBtn) {
    zenBtn.addEventListener('click', () => {
      document.body.classList.toggle('zen-mode-active');
      const isActive = document.body.classList.contains('zen-mode-active');
      zenBtn.textContent = isActive ? '✕ Exit Zen' : '☯ Zen Mode';
    });

    // Keyboard shortcut (Z)
    window.addEventListener('keydown', (e) => {
      if (e.key === 'z' || e.key === 'Z') {
        if (['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) return;
        zenBtn.click();
      }
    });
  }
</script>

<style>
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background-color: var(--accent);
    width: 0%;
    z-index: 1000;
    transition: width 0.1s ease-out;
  }

  .guide-layout-container {
    max-width: 1080px;
  }

  .breadcrumb {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-bottom: 2rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .breadcrumb a:hover {
    color: var(--text-primary);
  }

  .guide-grid {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 3.5rem;
  }

  .guide-article {
    min-width: 0;
  }

  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .header-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .order-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .zen-toggle-btn {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s;
  }

  .zen-toggle-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-focus);
  }

  .article-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .article-desc {
    font-size: 1.15rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }

  .article-footer {
    margin-top: 4rem;
  }

  .article-footer hr {
    border: 0;
    height: 1px;
    background-color: var(--border-color);
    margin-bottom: 2rem;
  }

  .back-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .back-link:hover {
    opacity: 0.75;
  }

  /* Global Zen Mode Styles */
  :global(body.zen-mode-active) .site-header,
  :global(body.zen-mode-active) .site-footer,
  :global(body.zen-mode-active) .guide-sidebar,
  :global(body.zen-mode-active) .breadcrumb {
    display: none !important;
  }

  :global(body.zen-mode-active) .guide-grid {
    grid-template-columns: 1fr !important;
    max-width: 680px;
    margin: 0 auto;
    padding-top: 3rem;
  }

  @media (max-width: 860px) {
    .guide-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .guide-sidebar {
      display: none;
    }
    .article-title {
      font-size: 2rem;
    }
  }
</style>

---
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  order: number;
  category: string;
  publishedDate: Date;
  readingTime: number;
  lang: SupportedLanguage;
  headings: { depth: number; slug: string; text: string }[];
}

const { title, description, order, publishedDate, readingTime, lang, headings } = Astro.props;
const t = useTranslations(lang);

const formattedDate = new Intl.DateTimeFormat(lang === 'lv' ? 'lv-LV' : lang === 'ru' ? 'ru-RU' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishedDate);
---

<BaseLayout title={title} description={description} lang={lang} type="article">
  <div class="container guide-layout-container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`/${lang}/`}>{t('nav.home')}</a>
      <span class="sep">/</span>
      <a href={getLocalizedPath('/guides/', lang)}>{t('nav.guides')}</a>
      <span class="sep">/</span>
      <span class="current">#{String(order).padStart(2, '0')}</span>
    </nav>

    <div class="guide-grid">
      <article class="guide-article">
        <header class="article-header">
          <div class="order-tag mono">GUIDE #{String(order).padStart(2, '0')}</div>
          <h1 class="article-title">{title}</h1>
          <p class="article-desc text-secondary">{description}</p>
          <div class="article-meta text-muted">
            <span>{t('meta.publishedOn')} {formattedDate}</span>
            <span class="dot">•</span>
            <span>{readingTime} {t('meta.readingTime')}</span>
          </div>
        </header>

        <div class="prose">
          <slot />
        </div>

        <footer class="article-footer">
          <hr />
          <div class="footer-cta">
            <a href={getLocalizedPath('/guides/', lang)} class="back-link">
              ← {t('section.guides.all')}
            </a>
          </div>
        </footer>
      </article>

      <div class="guide-sidebar">
        <TOC headings={headings} lang={lang} />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .guide-layout-container {
    max-width: 1080px;
  }

  .breadcrumb {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-bottom: 2rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .breadcrumb a:hover {
    color: var(--text-primary);
  }

  .guide-grid {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 3.5rem;
  }

  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .order-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .article-title {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.25;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .article-desc {
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }

  .article-footer {
    margin-top: 3.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .back-link:hover {
    opacity: 0.75;
  }

  @media (max-width: 860px) {
    .guide-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .guide-sidebar {
      display: none;
    }
  }
</style>
